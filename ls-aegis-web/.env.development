# 环境变量 (命名必须以 VITE_ 开头)
# 日常开发：npm run dev，浏览器访问 Vite(5173)；接口经 /api 代理到 Docker 后端 18000
# 不要访问 nginx 8080（那是部署态 dist，无 HMR）

# 接口前缀（与生产一致，由 Vite 代理剥离后转发）
VITE_API_PREFIX=/api

# Docker Compose 后端真实地址
VITE_API_BASE_URL=http://127.0.0.1:18000

# WebSocket
VITE_API_WS_URL=ws://127.0.0.1:18000

# 地址前缀
VITE_BASE=/

# 是否开启开发者工具
VITE_OPEN_DEVTOOLS=false

# 本地 mock（默认关闭；需要时改为 true）
VITE_LOCAL_MOCK=false

# 应用配置面板
VITE_APP_SETTING=true

# 客户端ID
VITE_CLIENT_ID=ef51c9a3e9046c4f2ea45142c8a8344a
