# 环境变量 (命名必须以 VITE_ 开头)

# 是否在打包时启用 Mock
VITE_BUILD_MOCK = false

# 接口地址（Docker 部署：同源 /api 由 nginx 反代到后端 18000）
VITE_API_PREFIX = '/api'
VITE_API_BASE_URL = '/api'
# WebSocket：留空则运行时用同源 ws/wss（nginx 已代理 /websocket）
VITE_API_WS_URL = ''

# 地址前缀
VITE_BASE = '/'

# 应用配置面板
VITE_APP_SETTING = true

# 客户端ID
VITE_CLIENT_ID = 'ef51c9a3e9046c4f2ea45142c8a8344a'